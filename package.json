    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/schedule": "^3.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "typeorm": "^0.3.20",
    "sql.js": "^1.14.2",
    "cheerio": "^1.0.0-rc.12",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "axios": "^1.7.0",
    "uuid": "^9.0.0"
